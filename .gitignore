#   models/*.onnx        <- produced by tools/convert_models.py
vendor/
models/*.onnx
models/_src/

# benchmark data for accuracy measurements (research-only licences, never redistributed)
bench/

# camera fingerprints built by the user
fingerprints/
fiasuite-error.log
